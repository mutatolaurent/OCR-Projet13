{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
<main>
    <section class="cnx-reg-sec">
        <img class="img-cnx" src="{{ asset('img/webp_deco/cnx-1.webp') }}" alt="" />
        <div class="div-form">
            <h1>Connexion</h1>

            <form method="post">
                {% if error %}
                    <div class="erreur-item-s14">&#10060; Echec: {{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="erreur-item-s14">
                        &#9888; Vous êtes déjà connecté avec le compte {{ app.user.userIdentifier }} <br/><a href="{{ logout_path() }}">Se déconnecter</a>
                    </div>
                {% endif %}

                <div class="champ-formulaire">
                    <label for="username">Adresse email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
                </div>
                
                <div class="champ-formulaire">
                    <label for="password">Mot de passe</label>
                    <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                {#
                    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                    See https://symfony.com/doc/current/security/remember_me.html

                    <div class="checkbox mb-3">
                        <input type="checkbox" name="_remember_me" id="_remember_me">
                        <label for="_remember_me">Remember me</label>
                    </div>
                #}

                <button class="btn-form">Se connecter</button>
            </form>
            <a href="{{ path('app_register') }}">Pas encore de compte ? S'inscrire</a>
        </div>
    </section>
</main>
{% endblock %}
