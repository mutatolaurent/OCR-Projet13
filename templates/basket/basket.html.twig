{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
    <main>
        <section class="panier-sec">
            <h1>Mon panier</h1>

            {% if basketItems is empty %}
                <div class="panier-list">
                    <p>Votre panier est actuellement vide.</p>
                    <a href="{{ path('app_main') }}" class="btn-form">Continuer mes achats</a>
                </div>
                
            {% else %}

                <div data-controller="modal">

                    <div class="panier-cta">
                        {# On cible ce formulaire avec data-modal-target="form" #}
                        <form data-modal-target="form" action="{{ path('app_basket_clear') }}" method="POST">
                            {# Au clic, on appelle la méthode open() du contrôleur #}
                            <button type="button" data-action="click->modal#open" class="panier-cta-remove" style="background: none; border: none; cursor: pointer; font: inherit;">
                                x Vider le panier
                            </button>
                        </form>
                    </div>

                    {# On cible la modale avec dialog et on gère le clic extérieur avec closeOutside #}
                    <div data-modal-target="dialog" data-action="click->modal#closeOutside" class="custom-modal">
                        <div class="custom-modal-content">
                            <h2>Vider le panier</h2>
                            <p>Êtes-vous sûr de vouloir vider entièrement votre panier ?<br>Cette action est irréversible.</p>
                            <div class="custom-modal-actions">
                                {# Bouton Annuler : appelle close() #}
                                <button type="button" data-action="click->modal#close" class="btn-modal-cancel">Annuler</button>
                                
                                {# Bouton Confirmer : cible confirmButton et appelle confirm() #}
                                <button type="button" data-modal-target="confirmButton" data-action="click->modal#confirm" class="btn-modal-confirm">
                                    Oui, vider le panier
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="panier-list">
                    {% for item in basketItems %}
                        <a class="panier-link" href="{{ path('app_product', {slug: item.product.slug}) }}">
                            <article>
                                <img
                                    class="panier-product-picture"
                                    src="{{ asset(image_paths.basket ~ item.product.picture) }}"
                                    alt="{{ item.product.name }}"
                                />
                                <div class="panier-product-descr">
                                    <h2>{{ item.product.name }}</h2>
                                    <p>Quantité: {{ item.quantity }}</p>
                                    <p>Prix unitaire: {{ item.product.priceCurrent }}</p>
                                    <h3>{{ item.subTotal|number_format(2, '.', ' ') }}€</h3>
                                </div>
                            </article>
                        </a>
                    {% endfor %}
                </div>
                <div class="panier-total">
                    <div class="panier-price">
                        <p>Total panier :</p>
                        <h3>{{ totalGeneral|number_format(2, '.', ' ') }}€</h3>
                    </div>
                    <p>Frais de livraison : Offert</p>
                </div>
                <a class="btn-valid marge-panier" href="{{ path('app_order_create') }}"
                    >Valider la commande</a
                >
            {% endif %}
        </section>
    </main>

{% endblock %}
