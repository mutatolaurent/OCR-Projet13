<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Accueil GreenGoodies{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>&#x26AB;&#xFE0F;</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body data-turbo-prefetch="false">
        <header>
            <a href="{{ path('app_main') }}" class="logo-block">
                <div class="logo-square">G</div>
                <span class="logo-text">Green Goodies</span>
            </a>
            {# Menu de navigation #}
            <nav>
                <ul>
                    <li><a href="{{ path('app_main') }}">Nos produits</a></li>
                    {% if app.user %}
                        <li><a href="{{ path('app_basket') }}">Mon panier<span class="badge-count">({{ basket_count() }})</span></a></li>
                        <li><a href="{{ path('app_account') }}">Mon compte</a></li>
                        <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
                    {% else %}
                        <li><a href="{{ path('app_register') }}">Inscription</a></li>
                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                    {% endif %}
                </ul>
            </nav>
        </header>

        {# Affichage des messages flash en popup #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                {# On attache le contrôleur "flash" et on lui passe la valeur 2000 #}
                <div class="flash-popup flash-{{ label }}" 
                    data-controller="flash" 
                    data-flash-duration-value="2000">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
        {# ==================================== #}

        {% block body %}{% endblock %}
        
        {# Pied de page #}
        <footer>
            <p>&copy; GreenGoodies - 2026</p>
        </footer>
    </body>
</html>