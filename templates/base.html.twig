<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Accueil GreenGoodies{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>&#x26AB;&#xFE0F;</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header>
            <a href="{{ path('app_main') }}" class="logo-block">
                <div class="logo-square">G</div>
                <span class="logo-text">Green Goodies</span>
            </a>
            {# Menu de navigation #}
            <nav>
                <ul>
                    <li><a href="{{ path('app_main') }}">Nos produits</a></li>
                    {% if app.user %}
                        <li><a href="{{ path('app_basket') }}">Mon panier<span class="badge-count">({{ basket_count() }})</span></a></li>
                        <li><a href="#">Mon compte</a></li>
                        <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
                    {% else %}
                        <li><a href="{{ path('app_register') }}">Inscription</a></li>
                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                    {% endif %}
                </ul>
            </nav>
        </header>

        {# Affichage des messages flash en popup #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-popup flash-{{ label }}" data-duration="2000">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
        {# ==================================== #}

        {% block body %}{% endblock %}
        
        {# Pied de page #}
        <footer>
            <p>&copy; GreenGoodies - 2026</p>
        </footer>
    </body>
    <script>
        (function() {
            const initPopups = () => {
                const popups = document.querySelectorAll('.flash-popup');
                
                popups.forEach(popup => {
                    // Récupère la durée (par défaut 4000ms si absent)
                    const duration = parseInt(popup.dataset.duration) || 4000;

                    // Lance le compte à rebours
                    setTimeout(() => {
                        // Ajoute la classe CSS pour déclencher le fondu
                        popup.classList.add('fade-out');

                        // Supprime l'élément du DOM après la transition (0.5s)
                        setTimeout(() => {
                            popup.remove();
                        }, 500);

                    }, duration);
                });
            };

            // Vérifie si le DOM est déjà chargé ou attend qu'il le soit
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initPopups);
            } else {
                initPopups();
            }
        })();    
    </script>
</html>