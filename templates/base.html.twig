<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Accueil GreenGoodies{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>&#x26AB;&#xFE0F;</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/header.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/footer.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/page-home.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/page-product.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/page-connexion-registration.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/page-panier.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/page-mon-compte.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header>
            <a href="{{ path('app_main') }}" class="logo-block">
                <div class="logo-square">G</div>
                <span class="logo-text">Green Goodies</span>
            </a>
            {# Menu de navigation #}
            <nav>
                <ul>
                    <li><a href="{{ path('app_main') }}">Nos produits</a></li>
                    {% if app.user %}
                        <li><a href="#">Mon panier</a></li>
                        <li><a href="#">Mon compte</a></li>
                        <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
                    {% else %}
                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                    {% endif %}
                </ul>
            </nav>
        </header>

        {% block body %}{% endblock %}
        
        {# Pied de page #}
        <footer>
            <p>&copy; GreenGoodies - 2026</p>
        </footer>
    </body>
</html>